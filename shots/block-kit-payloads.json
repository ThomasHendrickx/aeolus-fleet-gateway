            "block_id": "msg_q",
            "elements": [
              {
                "type": "button",
                "action_id": "answer-1",
                "text": {
                  "type": "plain_text",
                  "text": "1. Compact first"
                },
                "value": "1",
                "style": "primary"
              },
              {
                "type": "button",
                "action_id": "answer-2",
                "text": {
                  "type": "plain_text",
                  "text": "2. Harbour first"
                },
                "value": "2"
              },
              {
                "type": "button",
                "action_id": "answer-3",
                "text": {
                  "type": "plain_text",
                  "text": "3. Both in one PR"
