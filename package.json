{
  "name": "@aeolus-fleet/gateway",
  "version": "0.0.0",
  "description": "Aeolus gateway: outside MCP servers and clients join a fleet as ships, through one gateway beside core.",
  "keywords": [
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "gateway"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasHendrickx/aeolus-fleet-gateway.git"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "aeolus-gateway": "dist/bin/aeolus-gateway.js"
  },
  "files": [
    "dist",
    "web/.next",
    "!web/.next/cache",
    "!web/.next/dev",
    "web/next.config.ts",
    "web/public",
    "prisma.config.ts",
    "src/adapters/prisma/schema.prisma",
    "src/adapters/prisma/migrations"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build": "tsc --project tsconfig.build.json && next build web",
    "typecheck": "tsc --project tsconfig.json && next typegen web && tsc --project web/tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:unit": "vitest run --project '*:unit'",
    "test:integration": "vitest run --project '*:integration'",
    "start": "node dist/bin/aeolus-gateway.js start",
    "db:migrate": "tsx --env-file-if-exists=.env src/bin/aeolus-gateway.ts migrate"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@aeolus-fleet/common": "^0.32.0",
    "@base-ui/react": "^1.9.0",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.7",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aeolus-fleet/core": "^0.32.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-tasks": "0.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
